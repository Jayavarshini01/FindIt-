<html>
<head>
    <title>FindIt - Lost and Found</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f1f5f9;
            text-align: center;
        }

        header {
            background: #173b67;
            color: white;
            padding: 22px;
        }

        h1 {
            margin: 0;
        }

        .container {
            padding: 35px 20px;
        }

        .card {
            background: white;
            padding: 25px;
            margin: 20px auto;
            max-width: 350px;
            border-radius: 12px;
        }

        button {
            background: #1769aa;
            color: white;
            border: none;
            padding: 13px 22px;
            border-radius: 7px;
            margin: 8px;
            font-size: 16px;
        }

        footer {
            padding: 20px;
            color: #555;
        }
    </style>
</head>

<body>

<header>
    <h1>FindIt</h1>
    <p>Smart Lost and Found System</p>
</header>

<div class="container">

    <h2>Welcome to FindIt!</h2>

    <p>Lost something? Let's help you find it.</p>

    <div class="card">
        <h3>Lost an Item?</h3>
        <p>Report your missing belongings here.</p>
        <button>Report Lost Item</button>
    </div>

    <div class="card">
        <h3>Found an Item?</h3>
        <p>Help someone get their belongings back.</p>
        <button>Report Found Item</button>
    </div>

</div>

<footer>
    <p>© 2026 FindIt | All Rights Reserved</p>
</footer>

</body>
</html>
